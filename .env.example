# Required
GITHUB_TOKEN=ghp_...            # GitHub personal access token (repo scope)

# --- LLM provider (default: gemini, card-free) ---
# "gemini" = Google AI Studio Gemini API, OpenAI-compatible, free tier (NO credit card).
# "qwen"   = Alibaba Cloud Model Studio (needs an activated/paid DashScope account).
AUTOPR_LLM_PROVIDER=gemini

# Gemini (default provider) — get a free key at https://aistudio.google.com/apikey (no card)
GEMINI_API_KEY=AIza...
# LLM_TRIAGE_MODEL=gemini-2.5-flash   # optional override
# LLM_CODER_MODEL=gemini-2.5-flash    # optional (gemini-2.5-pro for harder fixes)

# Qwen fallback (only if AUTOPR_LLM_PROVIDER=qwen)
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional
LOOP_INTERVAL_S=900             # Seconds between full scans (default 15 min)
PORT=7860                       # Dashboard port
MIN_BOUNTY_USD=20               # Minimum bounty to attempt
